@model IEnumerable<Suttipong_9922_L004.Models.Advertisement>
@{
    ViewData["Title"] = "จัดการป้ายโฆษณา";
    Layout = "_AdminLayout";
}

@if (TempData["MarketingMsg"] != null)
{
    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MarketingMsg"]
    </div>
}

<div class="admin-panel">
    <form asp-controller="Marketing" asp-action="Ads" method="get" class="mb-4" style="max-width:440px;">
        <div class="input-group">
            <span class="input-group-text bg-light border-0"><i class="bi bi-search text-secondary"></i></span>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-0" placeholder="ค้นหาชื่อแคมเปญ" />
            <button type="submit" class="btn btn-tanglat px-4">ค้นหา</button>
        </div>
    </form>

    <div class="d-flex flex-column gap-3">
        @foreach (var ad in Model)
        {
            <div class="border rounded-4 p-3 bg-white d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <img src="@ad.ImageUrl" alt="@ad.Title" class="rounded-3 border" style="width:72px;height:52px;object-fit:cover;" />
                    <div>
                        <div class="fw-bold">@ad.Title</div>
                        <div class="small text-secondary">
                            <i class="bi bi-calendar3 me-1"></i>@ad.StartDate - @ad.EndDate
                            <span class="mx-1">•</span>
                            <i class="bi bi-eye me-1"></i>@(ad.ViewsCount ?? 0)
                            <span class="mx-1">•</span>
                            <i class="bi bi-cursor me-1"></i>@(ad.ClicksCount ?? 0)
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill @(ad.Status == "active" ? "bg-success" : ad.Status == "paused" ? "bg-warning text-dark" : "bg-danger")">
                        @(ad.Status == "active" ? "กำลังแสดงผล" : ad.Status == "paused" ? "พักการแสดงผล" : "ระงับ")
                    </span>

                    <form asp-controller="Marketing" asp-action="ToggleAdStatus" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@ad.Id" />
                        <input type="hidden" name="status" value="@(ad.Status == "active" ? "paused" : "active")" />
                        <button type="submit" class="btn btn-sm rounded-3 px-3 @(ad.Status == "active" ? "btn-outline-secondary" : "btn-tanglat")">
                            @(ad.Status == "active" ? "พักโฆษณา" : "เปิดแสดงผล")
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
