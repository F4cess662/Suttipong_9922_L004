@model IEnumerable<Suttipong_9922_L004.Models.Advertisement>
@{
    ViewData["Title"] = "ภาพรวมการตลาด";
    Layout = "_AdminLayout";
    string labelsJson = ViewBag.AdLabelsJson as string ?? "[]";
    string viewsJson = ViewBag.AdViewsJson as string ?? "[]";
    string clicksJson = ViewBag.AdClicksJson as string ?? "[]";
}

<div class="row g-4 mb-4">
    <div class="col-12 col-md-4">
        <div class="admin-panel h-100 mb-0">
            <div class="text-secondary small fw-semibold mb-2">โฆษณาที่กำลังแสดงผล</div>
            <div class="d-flex justify-content-between align-items-end">
                <div class="fs-2 fw-bold text-primary">@ViewBag.ActiveAdsCount</div>
                <span class="badge bg-primary-subtle text-primary p-2 rounded-3"><i class="bi bi-megaphone fs-4"></i></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="admin-panel h-100 mb-0">
            <div class="text-secondary small fw-semibold mb-2">จำนวนการมองเห็นรวม</div>
            <div class="d-flex justify-content-between align-items-end">
                <div class="fs-2 fw-bold text-success">@(((int)ViewBag.TotalViews).ToString("N0"))</div>
                <span class="badge bg-success-subtle text-success p-2 rounded-3"><i class="bi bi-eye fs-4"></i></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="admin-panel h-100 mb-0">
            <div class="text-secondary small fw-semibold mb-2">จำนวนการคลิกรวม</div>
            <div class="d-flex justify-content-between align-items-end">
                <div class="fs-2 fw-bold text-warning">@(((int)ViewBag.TotalClicks).ToString("N0"))</div>
                <span class="badge bg-warning-subtle text-dark p-2 rounded-3"><i class="bi bi-cursor fs-4"></i></span>
            </div>
        </div>
    </div>
</div>

<div class="admin-panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-danger me-2"></i>สถิติยอดมองเห็นและยอดคลิกแต่ละแคมเปญโฆษณา</h6>
        <div class="d-flex gap-2">
            <a asp-action="Ads" class="btn btn-sm btn-tanglat rounded-3">จัดการป้ายโฆษณา</a>
            <a asp-action="Promotions" class="btn btn-sm btn-light border rounded-3">แพ็กเกจสมาชิก</a>
        </div>
    </div>

    <div style="height: 300px;">
        <canvas id="marketingAdsChart"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('marketingAdsChart');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(labelsJson),
                datasets: [
                    {
                        label: 'จำนวนการมองเห็น (Views)',
                        data: @Html.Raw(viewsJson),
                        backgroundColor: '#0b3d2e',
                        borderRadius: 6
                    },
                    {
                        label: 'จำนวนการคลิก (Clicks)',
                        data: @Html.Raw(clicksJson),
                        backgroundColor: '#f59e0b',
                        borderRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}
