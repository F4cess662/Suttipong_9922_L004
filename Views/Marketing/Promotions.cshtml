@model IEnumerable<Suttipong_9922_L004.Models.SubscriptionPlan>
@{
    ViewData["Title"] = "จัดการแพ็กเกจสมาชิก";
    Layout = "_AdminLayout";
}

@if (TempData["PromoMsg"] != null)
{
    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["PromoMsg"]
    </div>
}

<div class="d-flex flex-column gap-3">
    @foreach (var plan in Model)
    {
        <div class="admin-panel p-4 mb-0 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width:52px;height:52px;">
                    @plan.Price.ToString("N0")฿
                </div>
                <div>
                    <h6 class="fw-bold mb-1">@plan.Name <span class="text-secondary fw-normal small">(@plan.DurationDays วัน)</span></h6>
                    <div class="small text-secondary">@plan.Description</div>
                </div>
            </div>

            <form asp-controller="Marketing" asp-action="TogglePlan" method="post" class="d-flex align-items-center gap-2">
                <input type="hidden" name="id" value="@plan.Id" />
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           @(plan.IsActive != false ? "checked" : "")
                           onchange="this.form.submit()"
                           style="width:46px;height:24px;cursor:pointer;" />
                </div>
            </form>
        </div>
    }

    <button type="button" class="btn btn-tanglat rounded-4 py-3 fw-bold fs-5 shadow-sm"
            data-bs-toggle="collapse" data-bs-target="#newPromoCollapse">
        <i class="bi bi-plus-lg"></i>
    </button>

    <div class="collapse" id="newPromoCollapse">
        <div class="admin-panel p-4">
            <h6 class="fw-bold mb-3">เพิ่มแพ็กเกจหรือโปรโมชั่นใหม่</h6>
            <form asp-controller="Marketing" asp-action="AddPromotion" method="post" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold">ชื่อแพ็กเกจ</label>
                    <input type="text" name="name" class="form-control bg-light border-0" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">ราคา (บาท)</label>
                    <input type="number" step="1" name="price" value="99" class="form-control bg-light border-0" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">ระยะเวลา (วัน)</label>
                    <input type="number" name="durationDays" value="30" class="form-control bg-light border-0" required />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">รายละเอียด</label>
                    <input type="text" name="description" class="form-control bg-light border-0" required />
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-tanglat px-4 rounded-3">บันทึก</button>
                </div>
            </form>
        </div>
    </div>
</div>
