@model Suttipong_9922_L004.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="container-fluid bg-light min-vh-100 py-5">
    <div class="container" style="max-width: 820px;">

        <!-- Page header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb small mb-1">
                        <li class="breadcrumb-item"><a href="#" class="link-secondary text-decoration-none">แดชบอร์ด</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Account" asp-action="UserList" class="link-secondary text-decoration-none">จัดการผู้ใช้งาน</a></li>
                        <li class="breadcrumb-item active">แก้ไขผู้ใช้งาน</li>
                    </ol>
                </nav>
                <h4 class="fw-bold mb-0">แก้ไขข้อมูลผู้ใช้งาน</h4>
            </div>
            <a asp-controller="Account" asp-action="UserList" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> กลับไปรายชื่อผู้ใช้
            </a>
        </div>

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">

                <form asp-controller="Account" asp-action="EditUser" method="post">
                    
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label">ชื่อผู้ใช้</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                                <input type="text" class="form-control" asp-for="Username" placeholder="ชื่อผู้ใช้งาน" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">อีเมล</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control" asp-for="Email" placeholder="example@email.com" required>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label">เบอร์โทรศัพท์</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-telephone"></i></span>
                                <input type="tel" class="form-control" asp-for="PhoneNumber"
                                       placeholder="08X-XXX-XXXX"
                                       maxlength="10"
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label d-block">สิทธิ์การใช้งาน</label>
                            <div class="d-flex gap-4 pt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Role" id="RoleUser" value="customer">
                                    <label class="form-check-label" for="RoleUser">ผู้ใช้งานทั่วไป</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Role" id="RoleAdmin" value="admin">
                                    <label class="form-check-label" for="RoleAdmin">ผู้ดูแลระบบ</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ส่วนเปลี่ยนรหัสผ่าน -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label">รหัสผ่านใหม่</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                                <input type="password" class="form-control" asp-for="Password" value="@Model.Password" placeholder="ตั้งรหัสผ่านใหม่" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label">ยืนยันรหัสผ่านใหม่</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-shield-lock"></i></span>
                                <input type="password" class="form-control" asp-for="ConfirmPassword" value="@Model.ConfirmPassword" placeholder="กรอกรหัสผ่านอีกครั้ง" required>
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive">
                        <label class="form-check-label" asp-for="IsActive">เปิดใช้งานบัญชี</label>
                    </div>

                    @if (ViewBag.Status != null)
                    {
                        <p class="text-danger mb-3">@ViewBag.Status</p>
                    }

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Account" asp-action="UserList" class="btn btn-outline-secondary px-4">ยกเลิก</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg"></i> บันทึกการแก้ไข
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>