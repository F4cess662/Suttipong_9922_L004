@model Suttipong_9922_L004.Models.Location
@{
    ViewData["Title"] = "แก้ไขสถานที่ท่องเที่ยว";
    ViewData["Department"] = "Dev";
    ViewData["ActiveMenu"] = "places";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">

        <div class="mb-3">
            <a asp-controller="Dev" asp-action="Places" class="btn btn-sm btn-light border rounded-3 px-3">
                <i class="bi bi-arrow-left me-1"></i>กลับหน้ารายการสถานที่
            </a>
        </div>

        <div class="admin-panel p-4 p-md-5">
            <h5 class="fw-bold mb-4 pb-3 border-bottom">
                <i class="bi bi-geo-alt text-success me-2"></i>แก้ไขข้อมูลสถานที่ #@Model.Id
            </h5>

            <form asp-controller="Dev" asp-action="EditPlace" method="post" enctype="multipart/form-data">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="row g-4 mb-4 align-items-center">
                    <div class="col-md-4 text-center">
                        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1563492065599-3520f775eeed?auto=format&fit=crop&w=600&q=80" : Model.ImageUrl)"
                             id="previewImg" alt="@Model.Name"
                             class="img-fluid rounded-4 border shadow-sm"
                             style="max-height: 180px; width: 100%; object-fit: cover;" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold"><i class="bi bi-upload me-1"></i>อัปโหลดไฟล์รูปภาพใหม่จากเครื่อง</label>
                        <input type="file" name="placeImage" accept="image/*" class="form-control bg-light border-0 py-2 mb-3"
                               onchange="if(this.files && this.files[0]) document.getElementById('previewImg').src = window.URL.createObjectURL(this.files[0]);" />

                        <label class="form-label small fw-semibold">หรือระบุลิงก์รูปภาพ (Image URL)</label>
                        <input type="text" name="imageUrl" value="@Model.ImageUrl" class="form-control bg-light border-0 py-2" placeholder="https://..." />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">ชื่อสถานที่</label>
                        <input type="text" name="name" value="@Model.Name" class="form-control bg-light border-0 py-2" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">หมวดหมู่</label>
                        <select name="category" class="form-select bg-light border-0 py-2">
                            <option value="attraction" selected="@(Model.Category == "attraction")">สถานที่ท่องเที่ยว</option>
                            <option value="restaurant" selected="@(Model.Category == "restaurant")">ร้านอาหาร</option>
                            <option value="shopping" selected="@(Model.Category == "shopping")">ช้อปปิ้ง</option>
                            <option value="transit_station" selected="@(Model.Category == "transit_station")">จุดเชื่อมต่อรถสาธารณะ</option>
                            <option value="other" selected="@(Model.Category == "other")">อื่นๆ</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">ที่อยู่ / เขต</label>
                        <input type="text" name="address" value="@Model.Address" class="form-control bg-light border-0 py-2" required />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">ละติจูด (Latitude)</label>
                        <input type="number" step="0.00000001" name="latitude" value="@Model.Latitude" class="form-control bg-light border-0 py-2" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">ลองจิจูด (Longitude)</label>
                        <input type="number" step="0.00000001" name="longitude" value="@Model.Longitude" class="form-control bg-light border-0 py-2" required />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" name="isActive" value="true" id="activeSwitch" @(Model.IsActive != false ? "checked" : "") />
                            <label class="form-check-label small fw-semibold" for="activeSwitch">เปิดแสดงผลบนแผนที่</label>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold">รายละเอียดสถานที่</label>
                    <textarea name="description" rows="3" class="form-control bg-light border-0" required>@Model.Description</textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-controller="Dev" asp-action="Places" class="btn btn-light border px-4 rounded-3">ยกเลิก</a>
                    <button type="submit" class="btn btn-tanglat px-4 rounded-3">
                        <i class="bi bi-check-lg me-1"></i>บันทึกการแก้ไข
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
