@model List<Suttipong_9922_L004.Models.Location>
@using System.Text.Json
@{
    ViewData["Title"] = "วางแผนเส้นทาง";
    Layout = "CustomerLayout";
    var allLocations = ViewBag.AllLocations as List<Suttipong_9922_L004.Models.Location> ?? Model;
    var transports = ViewBag.Transports as List<Suttipong_9922_L004.Models.TransportType> ?? new();
    var savedTrips = ViewBag.SavedTrips as List<Suttipong_9922_L004.Models.UserTrip> ?? new();

    var locationsJson = JsonSerializer.Serialize(Model.Select(l => new {
        id = l.Id,
        name = l.Name,
        address = l.Address ?? "กรุงเทพมหานคร",
        category = l.Category ?? "attraction",
        lat = (double)l.Latitude,
        lng = (double)l.Longitude
    }));
}

@if (TempData["SuccessMsg"] != null)
{
    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMsg"]
    </div>
}

<div class="row g-4">

    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 d-flex flex-column" style="background-color: #0b3d2e; color: #ffffff;">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-light border-opacity-10">
                <h6 class="fw-bold mb-0"><i class="bi bi-signpost-split me-2 text-warning"></i>ลำดับการเดินทาง</h6>
                <button type="button" class="btn btn-sm btn-outline-light rounded-3" onclick="optimizeRouteFromCurrentLocation()">
                    <i class="bi bi-crosshair me-1"></i>ตำแหน่งปัจจุบัน
                </button>
            </div>

            <div id="routeStopList" class="d-flex flex-column gap-2 mb-3 flex-grow-1"></div>

            <div class="bg-white bg-opacity-10 rounded-3 p-3 mt-auto">
                <div class="input-group input-group-sm">
                    <select id="addPlaceSelect" class="form-select border-0">
                        @foreach (var loc in allLocations)
                        {
                            <option value="@loc.Id" data-name="@loc.Name" data-lat="@loc.Latitude" data-lng="@loc.Longitude" data-address="@loc.Address">
                                @loc.Name
                            </option>
                        }
                    </select>
                    <button type="button" class="btn btn-light fw-semibold px-3" onclick="addPlaceToRoute()">
                        <i class="bi bi-plus-lg me-1"></i>เพิ่มจุดแวะ
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div id="tripMap" class="rounded-4 border mb-3" style="height: 340px; width: 100%; z-index: 1;"></div>

            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <div class="d-flex gap-2">
                    <span class="badge bg-light text-dark border px-3 py-2 fw-semibold">
                        <i class="bi bi-arrows-angle-expand text-success me-1"></i><span id="totalDistanceDisplay">0.00</span> กม.
                    </span>
                    <span class="badge bg-light text-dark border px-3 py-2 fw-semibold">
                        <i class="bi bi-clock text-primary me-1"></i><span id="totalDurationDisplay">0</span> นาที
                    </span>
                </div>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-dark active" id="btnModeSmart" onclick="selectTransportMode('smart')">
                        <i class="bi bi-stars me-1"></i>แนะนำ
                    </button>
                    <button type="button" class="btn btn-outline-dark" id="btnModeBus" onclick="selectTransportMode('bus')">
                        <i class="bi bi-bus-front me-1"></i>รถเมล์
                    </button>
                    <button type="button" class="btn btn-outline-dark" id="btnModeTrain" onclick="selectTransportMode('train')">
                        <i class="bi bi-train-front me-1"></i>รถไฟฟ้า
                    </button>
                    <button type="button" class="btn btn-outline-dark" id="btnModeMoto" onclick="selectTransportMode('motorcycle')">
                        <i class="bi bi-scooter me-1"></i>มอเตอร์ไซค์
                    </button>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <div class="p-3 rounded-3 border bg-light h-100 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-white border d-flex align-items-center justify-content-center text-primary flex-shrink-0" style="width:44px;height:44px;">
                            <i class="bi bi-bus-front fs-5"></i>
                        </div>
                        <div>
                            <div class="small text-secondary">รถโดยสารประจำทาง</div>
                            <div class="fw-bold text-dark" id="busCostText">0 บาท</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded-3 border bg-light h-100 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-white border d-flex align-items-center justify-content-center text-success flex-shrink-0" style="width:44px;height:44px;">
                            <i class="bi bi-train-front fs-5"></i>
                        </div>
                        <div>
                            <div class="small text-secondary">รถไฟฟ้า BTS / MRT</div>
                            <div class="fw-bold text-dark" id="trainCostText">0 บาท</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded-3 border bg-light h-100 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-white border d-flex align-items-center justify-content-center text-warning flex-shrink-0" style="width:44px;height:44px;">
                            <i class="bi bi-scooter fs-5"></i>
                        </div>
                        <div>
                            <div class="small text-secondary">รถมอเตอร์ไซค์รับจ้าง</div>
                            <div class="fw-bold text-dark" id="motoCostText">0 บาท</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded-3 border border-success bg-success-subtle bg-opacity-25 h-100 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-success text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width:44px;height:44px;">
                            <i class="bi bi-check2-circle fs-5"></i>
                        </div>
                        <div>
                            <div class="small text-success fw-semibold">เส้นทางแนะนำ</div>
                            <div class="fw-bold text-success" id="recommendedSummaryText">-</div>
                        </div>
                    </div>
                </div>
            </div>

            <form asp-controller="Customer" asp-action="SaveTrip" method="post" class="row g-2 align-items-center pt-3 border-top">
                <input type="hidden" name="locationIdsCsv" id="formLocationIdsCsv" />
                <input type="hidden" name="totalDistanceKm" id="formTotalDistanceKm" />
                <input type="hidden" name="estimatedCost" id="formEstimatedCost" />
                <input type="hidden" name="transportId" id="formTransportId" value="2" />

                <div class="col-md-6">
                    <input type="text" name="tripName" class="form-control" placeholder="ระบุชื่อทริป" required />
                </div>
                <div class="col-md-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isFavorite" value="true" id="favCheck" checked />
                        <label class="form-check-label small" for="favCheck"><i class="bi bi-bookmark-heart text-danger me-1"></i>รายการโปรด</label>
                    </div>
                </div>
                <div class="col-md-4 d-grid">
                    <button type="submit" class="btn btn-brand rounded-3 py-2">
                        <i class="bi bi-floppy me-1"></i>บันทึกทริป
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (savedTrips.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-4 mt-4 bg-white">
        <h6 class="fw-bold mb-3"><i class="bi bi-journal-bookmark text-success me-2"></i>ทริปที่บันทึกไว้</h6>
        <div class="row g-3">
            @foreach (var t in savedTrips)
            {
                <div class="col-md-6">
                    <div class="border rounded-3 p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">
                                @t.TripName
                                @if (t.IsFavorite == true)
                                {
                                    <i class="bi bi-bookmark-heart-fill text-danger small ms-1"></i>
                                }
                            </div>
                            <div class="small text-secondary">
                                <i class="bi bi-arrows-angle-expand me-1"></i>@t.TotalDistanceKm กม. • <i class="bi bi-cash me-1"></i>@t.EstimatedCost บาท
                            </div>
                        </div>
                        <span class="badge bg-light text-dark border">@t.TripLocations.Count จุดแวะ</span>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        let rawPlaces = @Html.Raw(locationsJson);
        let currentMode = 'smart';
        let map, polylineLayer;
        let markers = [];

        function calcRoadDistanceKm(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                      Math.sin(dLon / 2) * Math.sin(dLon / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return +(R * c * 1.25).toFixed(2);
        }

        function sortPlacesNearestNeighbor(places) {
            if (places.length <= 2) return places;
            let unvisited = [...places];
            let ordered = [unvisited.shift()];

            while (unvisited.length > 0) {
                let current = ordered[ordered.length - 1];
                let nearestIdx = 0;
                let minDist = Infinity;

                for (let i = 0; i < unvisited.length; i++) {
                    let d = calcRoadDistanceKm(current.lat, current.lng, unvisited[i].lat, unvisited[i].lng);
                    if (d < minDist) {
                        minDist = d;
                        nearestIdx = i;
                    }
                }
                ordered.push(unvisited.splice(nearestIdx, 1)[0]);
            }
            return ordered;
        }

        function recommendLegTransport(distKm) {
            if (distKm <= 2.2) return { icon: 'bi-scooter', label: 'มอเตอร์ไซค์', cost: Math.round(25 + distKm * 10), mins: Math.max(5, Math.round(distKm * 3)) };
            if (distKm <= 8.5) return { icon: 'bi-train-front', label: 'รถไฟฟ้า', cost: Math.round(17 + Math.ceil(distKm / 1.2) * 4), mins: Math.max(8, Math.round(distKm * 2.5)) };
            return { icon: 'bi-bus-front', label: 'รถโดยสาร', cost: Math.round(15 + distKm * 2), mins: Math.max(15, Math.round(distKm * 4)) };
        }

        function initMap() {
            map = L.map('tripMap').setView([13.7462, 100.5147], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);
            renderOptimizedRoute();
        }

        function renderOptimizedRoute() {
            rawPlaces = sortPlacesNearestNeighbor(rawPlaces);

            markers.forEach(m => map.removeLayer(m));
            markers = [];
            if (polylineLayer) map.removeLayer(polylineLayer);

            const stopListEl = document.getElementById('routeStopList');
            stopListEl.innerHTML = '';

            let latlngs = [];
            let totalKm = 0;
            let smartTotalCost = 0;
            let smartTotalMins = 0;

            rawPlaces.forEach((p, idx) => {
                latlngs.push([p.lat, p.lng]);

                let legHtml = '<span class="text-white-50 small"><i class="bi bi-geo-alt me-1"></i>จุดเริ่มต้น</span>';
                if (idx > 0) {
                    let prev = rawPlaces[idx - 1];
                    let legKm = calcRoadDistanceKm(prev.lat, prev.lng, p.lat, p.lng);
                    totalKm += legKm;
                    let rec = recommendLegTransport(legKm);
                    smartTotalCost += rec.cost;
                    smartTotalMins += rec.mins;
                    legHtml = `<span class="text-warning small"><i class="bi ${rec.icon} me-1"></i>${legKm.toFixed(2)} กม. • ${rec.label} (${rec.cost} ฿, ${rec.mins} นาที)</span>`;
                }

                let itemDiv = document.createElement('div');
                itemDiv.className = 'd-flex align-items-center justify-content-between p-3 rounded-3 bg-white bg-opacity-10';
                itemDiv.innerHTML = `
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-light text-dark fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width:32px;height:32px;font-size:13px;">
                            ${idx + 1}
                        </div>
                        <div>
                            <div class="fw-semibold text-white" style="font-size:14px;">${p.name}</div>
                            <div>${legHtml}</div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm text-white-50" onclick="removePlace(${p.id})">
                        <i class="bi bi-x-lg"></i>
                    </button>
                `;
                stopListEl.appendChild(itemDiv);

                let marker = L.marker([p.lat, p.lng]).addTo(map)
                    .bindPopup(`<strong>${idx + 1}. ${p.name}</strong><br/><small>${p.address}</small>`);
                markers.push(marker);
            });

            if (latlngs.length > 1) {
                polylineLayer = L.polyline(latlngs, { color: '#0b3d2e', weight: 4, opacity: 0.85 }).addTo(map);
                map.fitBounds(polylineLayer.getBounds(), { padding: [30, 30] });
            } else if (latlngs.length === 1) {
                map.setView(latlngs[0], 14);
            }

            let legs = Math.max(1, rawPlaces.length - 1);
            let busCost = Math.round(legs * 15 + totalKm * 2);
            let busMins = Math.round(totalKm * 4.2 + legs * 5);

            let trainStations = Math.max(legs, Math.ceil(totalKm / 1.2));
            let trainCost = Math.round(legs * 17 + trainStations * 4);
            let trainMins = Math.round(totalKm * 2.2 + legs * 4);

            let motoCost = Math.round(legs * 25 + totalKm * 10);
            let motoMins = Math.round(totalKm * 2.0 + legs * 2);

            document.getElementById('busCostText').innerText = `${busCost} ฿ (${busMins} นาที)`;
            document.getElementById('trainCostText').innerText = `${trainCost} ฿ (${trainMins} นาที)`;
            document.getElementById('motoCostText').innerText = `${motoCost} ฿ (${motoMins} นาที)`;
            document.getElementById('recommendedSummaryText').innerText = `${smartTotalCost} ฿ (${smartTotalMins} นาที)`;

            let displayCost = smartTotalCost;
            let displayMins = smartTotalMins;
            let transportId = 2;

            if (currentMode === 'bus') { displayCost = busCost; displayMins = busMins; transportId = 1; }
            else if (currentMode === 'train') { displayCost = trainCost; displayMins = trainMins; transportId = 2; }
            else if (currentMode === 'motorcycle') { displayCost = motoCost; displayMins = motoMins; transportId = 3; }

            document.getElementById('totalDistanceDisplay').innerText = totalKm.toFixed(2);
            document.getElementById('totalDurationDisplay').innerText = displayMins;

            document.getElementById('formLocationIdsCsv').value = rawPlaces.map(p => p.id).join(',');
            document.getElementById('formTotalDistanceKm').value = totalKm.toFixed(2);
            document.getElementById('formEstimatedCost').value = displayCost;
            document.getElementById('formTransportId').value = transportId;
        }

        function selectTransportMode(mode) {
            currentMode = mode;
            ['Smart', 'Bus', 'Train', 'Moto'].forEach(m => {
                document.getElementById('btnMode' + m).classList.remove('active');
            });
            if (mode === 'smart') document.getElementById('btnModeSmart').classList.add('active');
            if (mode === 'bus') document.getElementById('btnModeBus').classList.add('active');
            if (mode === 'train') document.getElementById('btnModeTrain').classList.add('active');
            if (mode === 'motorcycle') document.getElementById('btnModeMoto').classList.add('active');
            renderOptimizedRoute();
        }

        function removePlace(id) {
            if (rawPlaces.length <= 1) return;
            rawPlaces = rawPlaces.filter(p => p.id !== id);
            renderOptimizedRoute();
        }

        function addPlaceToRoute() {
            const sel = document.getElementById('addPlaceSelect');
            const opt = sel.options[sel.selectedIndex];
            const id = parseInt(opt.value);
            if (rawPlaces.some(p => p.id === id)) return;
            rawPlaces.push({
                id: id,
                name: opt.getAttribute('data-name'),
                address: opt.getAttribute('data-address') || 'กรุงเทพมหานคร',
                lat: parseFloat(opt.getAttribute('data-lat')),
                lng: parseFloat(opt.getAttribute('data-lng'))
            });
            renderOptimizedRoute();
        }

        function optimizeRouteFromCurrentLocation() {
            if (!navigator.geolocation) return;
            navigator.geolocation.getCurrentPosition(pos => {
                rawPlaces.unshift({
                    id: 999,
                    name: 'ตำแหน่งปัจจุบัน',
                    address: 'GPS',
                    lat: pos.coords.latitude,
                    lng: pos.coords.longitude
                });
                renderOptimizedRoute();
            });
        }

        window.addEventListener('DOMContentLoaded', initMap);
    </script>
}
