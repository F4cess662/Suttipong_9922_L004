@model Suttipong_9922_L004.ViewModels.AddUserViewModel
@{
    ViewData["Title"] = "เพิ่มผู้ใช้งาน / พนักงานใหม่";
    ViewData["Department"] = "Dev";
    ViewData["ActiveMenu"] = "users";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">

        <div class="d-flex align-items-center justify-content-between mb-3">
            <a asp-controller="Dev" asp-action="UserList" class="btn btn-sm btn-light border rounded-3 px-3">
                <i class="bi bi-arrow-left me-1"></i>กลับหน้ารายชื่อผู้ใช้งาน
            </a>
        </div>

        <div class="admin-panel p-4 p-md-5">
            <h5 class="fw-bold mb-4 pb-3 border-bottom"><i class="bi bi-person-plus text-success me-2"></i>ข้อมูลบัญชีผู้ใช้งาน</h5>

            <form asp-controller="Dev" asp-action="AddUser" method="post" enctype="multipart/form-data">

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label small fw-semibold">ชื่อผู้ใช้งาน (Username)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-person"></i></span>
                            <input type="text" class="form-control bg-light border-0 py-2" asp-for="Username" placeholder="ตั้งชื่อผู้ใช้งาน" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold">อีเมล</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-envelope"></i></span>
                            <input type="email" class="form-control bg-light border-0 py-2" asp-for="Email" placeholder="name@tanglat.com" required />
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label small fw-semibold">เบอร์โทรศัพท์</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-telephone"></i></span>
                            <input type="tel" class="form-control bg-light border-0 py-2" asp-for="PhoneNumber"
                                   placeholder="08X-XXX-XXXX" maxlength="10"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label small fw-semibold">รหัสผ่านเริ่มต้น</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-lock"></i></span>
                            <input type="password" class="form-control bg-light border-0 py-2" asp-for="Password" placeholder="ตั้งรหัสผ่าน" required />
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold d-block">ประเภทบัญชี (Role)</label>
                        <div class="d-flex flex-wrap gap-4 pt-1">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Role" id="RoleCustomer" value="customer" checked onchange="toggleEmployeeFields()" />
                                <label class="form-check-label small" for="RoleCustomer">ลูกค้าทั่วไป (Customer)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Role" id="RoleEmployee" value="employee" onchange="toggleEmployeeFields()" />
                                <label class="form-check-label small fw-semibold text-primary" for="RoleEmployee">พนักงาน (Employee)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Role" id="RoleAdmin" value="admin" onchange="toggleEmployeeFields()" />
                                <label class="form-check-label small" for="RoleAdmin">ผู้ดูแลระบบ (Dev / Admin)</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" />
                            <label class="form-check-label small fw-semibold" asp-for="IsActive">เปิดใช้งานบัญชีทันที</label>
                        </div>
                    </div>
                </div>

                <!-- ส่วนข้อมูลพนักงาน (แสดงเมื่อเลือกเป็น พนักงาน หรือ ผู้ดูแลระบบ) -->
                <div id="employeeSection" class="p-4 rounded-4 bg-light border mb-4" style="display:none;">
                    <h6 class="fw-bold mb-3"><i class="bi bi-briefcase text-primary me-2"></i>รายละเอียดพนักงานและสังกัดแผนก</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label small fw-semibold">ชื่อจริง</label>
                            <input type="text" class="form-control bg-white border-0 py-2" asp-for="FirstName" placeholder="ชื่อจริงพนักงาน" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label small fw-semibold">นามสกุล</label>
                            <input type="text" class="form-control bg-white border-0 py-2" asp-for="LastName" placeholder="นามสกุลพนักงาน" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Department" class="form-label small fw-semibold">แผนก (Department)</label>
                            <select asp-for="Department" class="form-select bg-white border-0 py-2">
                                <option value="Dev">ฝ่ายพัฒนาระบบ (Dev)</option>
                                <option value="Support">ฝ่ายซัพพอร์ต (Support)</option>
                                <option value="Marketing">ฝ่ายการตลาด (Marketing)</option>
                                <option value="Accounting">ฝ่ายบัญชี (Accounting)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Position" class="form-label small fw-semibold">ตำแหน่ง (Position)</label>
                            <input type="text" class="form-control bg-white border-0 py-2" asp-for="Position" placeholder="เช่น Developer, Support Officer" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Salary" class="form-label small fw-semibold">ฐานเงินเดือน (บาท)</label>
                            <input type="number" step="500" class="form-control bg-white border-0 py-2" asp-for="Salary" />
                        </div>
                    </div>
                </div>

                @if (ViewBag.Status != null)
                {
                    <div class="alert alert-danger py-2 small">@ViewBag.Status</div>
                }

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-controller="Dev" asp-action="UserList" class="btn btn-light border px-4 rounded-3">ยกเลิก</a>
                    <button type="submit" class="btn btn-tanglat px-4 rounded-3">
                        <i class="bi bi-check-lg me-1"></i>บันทึกข้อมูล
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleEmployeeFields() {
            const isEmp = document.getElementById('RoleEmployee').checked || document.getElementById('RoleAdmin').checked;
            document.getElementById('employeeSection').style.display = isEmp ? 'block' : 'none';
        }
        window.addEventListener('DOMContentLoaded', toggleEmployeeFields);
    </script>
}