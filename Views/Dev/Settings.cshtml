@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "ตั้งค่าบัญชี";
    Layout = "_AdminLayout";
    var username = Context.Session.GetString("Username") ?? "staff_user";
    var email = Context.Session.GetString("Email") ?? "staff@tanglat.com";
    var dept = ViewData["Department"] as string ?? Context.Session.GetString("Department") ?? "Dev";
    var initial = username.Substring(0, 1).ToUpper();
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="admin-panel p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 pb-4 mb-4 border-bottom">
                <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold fs-3" style="width:68px;height:68px;">
                    @initial
                </div>
                <div>
                    <h5 class="fw-bold mb-1">@username</h5>
                    <span class="badge bg-light text-dark border">ฝ่าย: @dept</span>
                    <div class="small text-secondary mt-1">@email</div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">ชื่อผู้ใช้งาน</label>
                <input type="text" class="form-control bg-light border-0 py-2" value="@username" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">อีเมล</label>
                <input type="email" class="form-control bg-light border-0 py-2" value="@email" readonly />
            </div>

            <div class="d-flex justify-content-between align-items-center py-3 border-top border-bottom mb-4">
                <div>
                    <div class="fw-semibold small">การแจ้งเตือนระบบ</div>
                    <div class="small text-secondary">รับการแจ้งเตือนเมื่อมีรายการส่งต่อใหม่</div>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" checked style="width:42px;height:22px;" />
                </div>
            </div>

            <div class="d-grid">
                <a asp-controller="Account" asp-action="Logout" class="btn btn-tanglat py-2 rounded-3">
                    <i class="bi bi-box-arrow-right me-1"></i>ออกจากระบบ
                </a>
            </div>
        </div>
    </div>
</div>
