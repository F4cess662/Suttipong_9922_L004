@model IEnumerable<Suttipong_9922_L004.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "จัดการผู้ใช้งานและพนักงาน";
    ViewData["Department"] = "Dev";
    ViewData["ActiveMenu"] = "users";
    Layout = "_AdminLayout";
    string roleFilter = ViewBag.RoleFilter as string ?? "all";
}

@if (TempData["UserMsg"] != null)
{
    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["UserMsg"]
    </div>
}

<div class="admin-panel">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <form asp-controller="Dev" asp-action="UserList" method="get" class="d-flex gap-2 flex-grow-1" style="max-width: 480px;">
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="bi bi-search text-secondary"></i></span>
                <input type="search" name="search" value="@ViewBag.Search" class="form-control bg-light border-0"
                       placeholder="ค้นหาชื่อ, อีเมล หรือแผนก..." />
                <button type="submit" class="btn btn-tanglat px-4">ค้นหา</button>
            </div>
        </form>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-controller="Dev" asp-action="UserList" asp-route-roleFilter="all"
               class="btn btn-sm rounded-pill px-3 @(roleFilter == "all" ? "btn-tanglat" : "btn-outline-secondary")">ทั้งหมด (@Model.Count())</a>
            <a asp-controller="Dev" asp-action="UserList" asp-route-roleFilter="employee"
               class="btn btn-sm rounded-pill px-3 @(roleFilter == "employee" ? "btn-tanglat" : "btn-outline-secondary")">พนักงาน</a>
            <a asp-controller="Dev" asp-action="UserList" asp-route-roleFilter="customer"
               class="btn btn-sm rounded-pill px-3 @(roleFilter == "customer" ? "btn-tanglat" : "btn-outline-secondary")">ลูกค้าทั่วไป</a>

            <a asp-controller="Dev" asp-action="AddUser" class="btn btn-tanglat btn-sm rounded-3 px-3 ms-md-2 py-2">
                <i class="bi bi-person-plus me-1"></i>เพิ่มผู้ใช้งาน / พนักงาน
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th style="width: 52px;"></th>
                    <th>ชื่อ-นามสกุล / บัญชี</th>
                    <th>อีเมล</th>
                    <th>เบอร์โทรศัพท์</th>
                    <th>สิทธิ์การใช้งาน</th>
                    <th>แผนก / ตำแหน่ง</th>
                    <th>สถานะ</th>
                    <th class="text-end">การจัดการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var initial = !string.IsNullOrEmpty(item.Username) ? item.Username.Substring(0, 1).ToUpper() : "U";
                    <tr>
                        <td>
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-dark text-white fw-bold"
                                 style="width:38px;height:38px;font-size:13px;">
                                @initial
                            </div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.FullName</div>
                            <div class="text-secondary small">@@@item.Username</div>
                        </td>
                        <td class="small">@item.Email</td>
                        <td class="small">@item.PhoneNumber</td>
                        <td>
                            @if (item.Role == "admin")
                            {
                                <span class="badge rounded-pill bg-dark">ผู้ดูแลระบบ (Dev/Admin)</span>
                            }
                            else if (item.Role == "employee")
                            {
                                <span class="badge rounded-pill bg-primary-subtle text-primary">พนักงาน</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-light text-secondary border">ลูกค้าทั่วไป</span>
                            }
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(item.Department) && item.Department != "-")
                            {
                                <span class="fw-semibold text-dark">@item.Department</span>
                                <div class="text-secondary" style="font-size: 12px;">@item.Position</div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (item.Status == "active")
                            {
                                <span class="badge rounded-pill bg-success-subtle text-success"><i class="bi bi-circle-fill me-1" style="font-size:7px;"></i>ใช้งานอยู่</span>
                            }
                            else if (item.Status == "pending")
                            {
                                <span class="badge rounded-pill bg-warning-subtle text-dark">รออนุมัติ</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-light text-secondary border">ระงับ</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-controller="Dev" asp-action="EditUser" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light border rounded-3" title="แก้ไข">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-controller="Dev" asp-action="DeleteUser" asp-route-id="@item.Id" method="post"
                                      class="d-inline" onsubmit="return confirm('ยืนยันการลบบัญชี @item.Username ?');">
                                    <button type="submit" class="btn btn-sm btn-light border text-danger rounded-3" title="ลบ">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="small text-secondary">
                    <th colspan="7" class="fw-normal pt-3">รวมบัญชีทั้งหมดในระบบ</th>
                    <th class="text-end pt-3">@Model.Count() บัญชี</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>