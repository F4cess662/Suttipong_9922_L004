@{
    ViewData["Title"] = "แดชบอร์ดระบบ";
    Layout = "_AdminLayout";
}

<div class="row g-4 mb-4">
    <div class="col-12 col-lg-6">
        <div class="admin-panel h-100 mb-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-hdd-network text-primary me-2"></i>ข้อมูลระบบและพิกัดสถานที่</h6>
                <span class="badge bg-success-subtle text-success"><i class="bi bi-circle-fill me-1" style="font-size:8px;"></i>ออนไลน์</span>
            </div>
            <div class="p-4 rounded-3 bg-light mb-3 text-center">
                <div class="row g-3">
                    <div class="col-6 border-end">
                        <div class="text-secondary small">สถานที่ในระบบ</div>
                        <div class="fs-2 fw-bold text-dark">@ViewBag.LocationCount</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary small">ระบบขนส่งสาธารณะ</div>
                        <div class="fs-2 fw-bold text-primary">@ViewBag.TransportCount</div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-between small text-secondary">
                <span><i class="bi bi-map text-success me-1"></i>Leaflet Map Service</span>
                <span><i class="bi bi-database-check text-success me-1"></i>MySQL Database</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="admin-panel h-100 mb-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-exclamation-octagon text-danger me-2"></i>สถานะคำร้องและผู้ใช้งาน</h6>
                <a asp-action="Issues" class="btn btn-sm btn-light border rounded-3">ดูทั้งหมด</a>
            </div>
            <div class="p-4 rounded-3 bg-light mb-3 text-center">
                <div class="row g-3">
                    <div class="col-6 border-end">
                        <div class="text-secondary small">รอดำเนินการ</div>
                        <div class="fs-2 fw-bold text-danger">@ViewBag.OpenBugs</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary small">ผู้ใช้งานทั้งหมด</div>
                        <div class="fs-2 fw-bold text-success">@ViewBag.TotalUsers</div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-between small text-secondary">
                <span><i class="bi bi-clock text-warning me-1"></i>อัปเดตล่าสุดวันนี้</span>
                <span><i class="bi bi-shield-check text-primary me-1"></i>ระบบทำงานปกติ</span>
            </div>
        </div>
    </div>
</div>

<div class="admin-panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart-steps text-success me-2"></i>สัดส่วนการแนะนำระบบขนส่งสาธารณะ</h6>
        <div class="d-flex gap-2">
            <a asp-action="Places" class="btn btn-sm btn-tanglat rounded-3"><i class="bi bi-geo-alt me-1"></i>สถานที่ท่องเที่ยว</a>
            <a asp-action="Pricing" class="btn btn-sm btn-light border rounded-3"><i class="bi bi-sliders me-1"></i>อัตราค่าโดยสาร</a>
        </div>
    </div>

    <div class="p-4 rounded-3 bg-light mb-3">
        <div class="mb-3">
            <div class="d-flex justify-content-between small fw-semibold mb-1">
                <span><i class="bi bi-train-front text-success me-1"></i>รถไฟฟ้า BTS / MRT</span>
                <span>48%</span>
            </div>
            <div class="progress" style="height: 10px;">
                <div class="progress-bar bg-success" style="width: 48%"></div>
            </div>
        </div>
        <div class="mb-3">
            <div class="d-flex justify-content-between small fw-semibold mb-1">
                <span><i class="bi bi-bus-front text-primary me-1"></i>รถโดยสารประจำทาง</span>
                <span>32%</span>
            </div>
            <div class="progress" style="height: 10px;">
                <div class="progress-bar bg-primary" style="width: 32%"></div>
            </div>
        </div>
        <div>
            <div class="d-flex justify-content-between small fw-semibold mb-1">
                <span><i class="bi bi-scooter text-warning me-1"></i>รถมอเตอร์ไซค์รับจ้าง</span>
                <span>20%</span>
            </div>
            <div class="progress" style="height: 10px;">
                <div class="progress-bar bg-warning" style="width: 20%"></div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-around small text-secondary pt-2">
        <span><i class="bi bi-circle-fill text-success me-1"></i>รถไฟฟ้า</span>
        <span><i class="bi bi-circle-fill text-primary me-1"></i>รถโดยสาร</span>
        <span><i class="bi bi-circle-fill text-warning me-1"></i>มอเตอร์ไซค์รับจ้าง</span>
    </div>
</div>
