@{
    ViewData["Title"] = "Index";
}

<div class="container-fluid bg-light min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5 bg-white" style="max-width: 600px; width: 100%;">

        <h4 class="fw-bold mb-1">เข้าสู่ระบบสำเร็จ</h4>

        <p><strong>ชื่อผู้ใช้:</strong> @ViewBag.Username</p>

        @if (!string.IsNullOrEmpty(ViewBag.Email))
        {
            <p><strong>อีเมล:</strong> @ViewBag.Email</p>
        }

        @if (!string.IsNullOrEmpty(ViewBag.PhoneNumber))
        {
            <p><strong>เบอร์โทรศัพท์:</strong> @ViewBag.PhoneNumber</p>
        }

        <p><strong>จดจำฉัน:</strong> @(ViewBag.RememberMe ? "ใช่" : "ไม่")</p>

        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary mt-3">กลับไปหน้า Login</a>
    </div>
</div>
