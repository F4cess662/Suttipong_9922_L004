@model IEnumerable<Suttipong_9922_L004.Models.Payment>
@{
    ViewData["Title"] = "ภาพรวมการเงิน";
    Layout = "_AdminLayout";
    decimal totalRev = ViewBag.TotalRevenue as decimal? ?? 0m;
    decimal pendingRev = ViewBag.PendingRevenue as decimal? ?? 0m;
    decimal totalPayroll = ViewBag.TotalPayroll as decimal? ?? 0m;
    string financeChartJson = ViewBag.FinanceChartJson as string ?? "[0,0,0]";
}

<style>
    @@media print {
        .admin-sidebar, .admin-topbar, .no-print {
            display: none !important;
        }
        .admin-main, .admin-content {
            padding: 0 !important;
            background: #fff !important;
        }
    }
</style>

<div class="row g-4 mb-4">
    <div class="col-12 col-md-4">
        <div class="admin-panel h-100 mb-0">
            <div class="text-secondary small fw-semibold mb-2">รายรับยืนยันแล้ว</div>
            <div class="d-flex justify-content-between align-items-end">
                <div class="fs-2 fw-bold text-success">@totalRev.ToString("N2") ฿</div>
                <span class="badge bg-success-subtle text-success p-2 rounded-3"><i class="bi bi-cash-stack fs-4"></i></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="admin-panel h-100 mb-0">
            <div class="text-secondary small fw-semibold mb-2">ยอดรอตรวจสอบ (@ViewBag.PendingCount)</div>
            <div class="d-flex justify-content-between align-items-end">
                <div class="fs-2 fw-bold text-warning">@pendingRev.ToString("N2") ฿</div>
                <span class="badge bg-warning-subtle text-dark p-2 rounded-3"><i class="bi bi-hourglass-split fs-4"></i></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="admin-panel h-100 mb-0">
            <div class="text-secondary small fw-semibold mb-2">งบเงินเดือนพนักงานต่อเดือน</div>
            <div class="d-flex justify-content-between align-items-end">
                <div class="fs-2 fw-bold text-primary">@totalPayroll.ToString("N2") ฿</div>
                <span class="badge bg-primary-subtle text-primary p-2 rounded-3"><i class="bi bi-people fs-4"></i></span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-lg-5">
        <div class="admin-panel h-100 mb-0">
            <h6 class="fw-bold mb-3"><i class="bi bi-pie-chart-fill text-success me-2"></i>สัดส่วนรายรับตามประเภทบริการ</h6>
            <div style="height: 240px;">
                <canvas id="accountingFinanceChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="admin-panel h-100 mb-0">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-receipt-cutoff text-primary me-2"></i>ธุรกรรมล่าสุด</h6>
                <div class="d-flex flex-wrap gap-2 no-print">
                    <a asp-action="ExportPaymentsCsv" class="btn btn-sm btn-outline-success rounded-3">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
                    </a>
                    <button type="button" onclick="window.print()" class="btn btn-sm btn-light border rounded-3">
                        <i class="bi bi-printer me-1"></i>พิมพ์รายงาน
                    </button>
                    <a asp-action="Payments" class="btn btn-sm btn-tanglat rounded-3">ตรวจสอบยอด</a>
                </div>
            </div>

            <div class="d-flex flex-column gap-2">
                @foreach (var p in Model.Take(5))
                {
                    string cleanRef = (p.TransactionRef ?? "-").Split('|')[0].Trim();
                    <div class="border rounded-3 p-3 bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-white border d-flex align-items-center justify-content-center text-dark" style="width:40px;height:40px;">
                                <i class="bi @(p.SubscriptionPlanId != null ? "bi-gem text-success" : "bi-megaphone text-primary")"></i>
                            </div>
                            <div>
                                <div class="fw-bold small">
                                    @(p.SubscriptionPlan != null ? p.SubscriptionPlan.Name : p.Advertisement != null ? p.Advertisement.Title : "รายการชำระเงิน #" + p.Id)
                                </div>
                                <div class="small text-secondary">@cleanRef • @(p.User?.UserName ?? "customer")</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold">+@p.Amount.ToString("N2") ฿</div>
                            <span class="badge rounded-pill @(p.PaymentStatus == "completed" ? "bg-success" : p.PaymentStatus == "pending" ? "bg-warning text-dark" : "bg-danger")">
                                @(p.PaymentStatus == "completed" ? "ยืนยันแล้ว" : p.PaymentStatus == "pending" ? "รอตรวจสอบ" : "ไม่สำเร็จ")
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('accountingFinanceChart');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['รายได้สมาชิก VIP (บาท)', 'รายได้ป้ายโฆษณา (บาท)', 'ยอดรอตรวจสอบ (บาท)'],
                datasets: [{
                    data: @Html.Raw(financeChartJson),
                    backgroundColor: ['#0b3d2e', '#0d6efd', '#f59e0b'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });
    </script>
}
