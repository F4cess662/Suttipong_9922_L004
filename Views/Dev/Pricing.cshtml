@model IEnumerable<Suttipong_9922_L004.Models.TransportType>
@{
    ViewData["Title"] = "อัตราค่าโดยสารสาธารณะ";
    Layout = "_AdminLayout";
}

@if (TempData["PricingMsg"] != null)
{
    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["PricingMsg"]
    </div>
}

<div class="admin-panel">
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-lg-6">
                <div class="border rounded-4 p-4 bg-light h-100">
                    <form asp-controller="Dev" asp-action="UpdatePricing" method="post">
                        <input type="hidden" name="id" value="@item.Id" />

                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-3 bg-white border text-dark d-flex align-items-center justify-content-center flex-shrink-0" style="width:46px;height:46px;">
                                <i class="bi @(item.Type == "train" ? "bi-train-front" : item.Type == "bus" ? "bi-bus-front" : "bi-scooter") fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <input type="text" name="name" value="@item.Name" class="form-control fw-bold border-0 bg-white" required />
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <label class="form-label small text-secondary">ค่าเริ่มต้น (฿)</label>
                                <input type="number" step="0.50" name="baseFare" value="@item.BaseFare" class="form-control border-0 bg-white" required />
                            </div>
                            <div class="col-4">
                                <label class="form-label small text-secondary">ต่อกิโลเมตร (฿)</label>
                                <input type="number" step="0.50" name="farePerKm" value="@item.FarePerKm" class="form-control border-0 bg-white" required />
                            </div>
                            <div class="col-4">
                                <label class="form-label small text-secondary">ต่อสถานี (฿)</label>
                                <input type="number" step="0.50" name="farePerStation" value="@item.FarePerStation" class="form-control border-0 bg-white" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-secondary">หมายเหตุ</label>
                            <input type="text" name="description" value="@item.Description" class="form-control border-0 bg-white" />
                        </div>

                        <button type="submit" class="btn btn-tanglat w-100 rounded-3 py-2">
                            <i class="bi bi-check2 me-1"></i>บันทึกอัตราค่าโดยสาร
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
