@model Suttipong_9922_L004.Models.User
@{
    ViewData["Title"] = "ตั้งค่าบัญชี";
    Layout = "CustomerLayout";
    bool isVip = ViewBag.IsVip as bool? ?? false;
    string initial = !string.IsNullOrEmpty(Model.UserName) ? Model.UserName.Substring(0, 1).ToUpper() : "U";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">

        @if (TempData["ProfileMsg"] != null)
        {
            <div class="alert alert-success border-0 rounded-4 shadow-sm mb-3">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["ProfileMsg"]
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex align-items-center gap-3 pb-4 mb-4 border-bottom">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-3 text-white position-relative"
                     style="width:68px;height:68px;background-color:#0b3d2e;">
                    @initial
                </div>
                <div>
                    <h5 class="fw-bold mb-1">
                        @Model.UserName
                        @if (isVip)
                        {
                            <span class="badge bg-success-subtle text-success ms-1 small"><i class="bi bi-gem me-1"></i>VIP</span>
                        }
                    </h5>
                    <div class="text-secondary small">@Model.Email</div>
                </div>
            </div>

            <form asp-controller="Customer" asp-action="UpdateProfile" method="post">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">ชื่อผู้ใช้งาน</label>
                    <input type="text" name="userName" value="@Model.UserName" class="form-control bg-light border-0 py-2" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">อีเมล</label>
                    <input type="email" name="email" value="@Model.Email" class="form-control bg-light border-0 py-2" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">เบอร์โทรศัพท์</label>
                    <input type="tel" name="phoneNumber" value="@Model.PhoneNumber" class="form-control bg-light border-0 py-2" />
                </div>

                <div class="d-flex justify-content-between align-items-center py-3 border-top border-bottom mb-4">
                    <div>
                        <div class="fw-semibold small">การแจ้งเตือนทางอีเมล</div>
                        <div class="small text-secondary">รับแจ้งเตือนสถานะคำร้องและข่าวสาร</div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" checked style="width:42px;height:22px;" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-brand rounded-3 flex-grow-1 py-2">
                        <i class="bi bi-check2 me-1"></i>บันทึกข้อมูล
                    </button>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger rounded-3 px-4 py-2">
                        <i class="bi bi-box-arrow-right me-1"></i>ออกจากระบบ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
