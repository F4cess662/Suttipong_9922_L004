@{
    ViewData["Title"] = "ลงโฆษณา";
    Layout = "CustomerLayout";
    var myAds = ViewBag.MyAds as List<Suttipong_9922_L004.Models.Advertisement> ?? new();
}

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h6 class="fw-bold mb-3"><i class="bi bi-megaphone text-success me-2"></i>สร้างแคมเปญโฆษณา</h6>

            <form asp-controller="Customer" asp-action="CreateAd" method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">ชื่อแคมเปญ</label>
                    <input type="text" name="title" class="form-control bg-light border-0 py-2" placeholder="ระบุข้อความโฆษณา" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">ลิงก์รูปภาพแบนเนอร์</label>
                    <input type="url" name="imageUrl" class="form-control bg-light border-0 py-2" placeholder="https://..." required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">ลิงก์ปลายทาง</label>
                    <input type="url" name="redirectUrl" class="form-control bg-light border-0 py-2" placeholder="https://..." required />
                </div>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">วันที่เริ่ม</label>
                        <input type="date" name="startDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control bg-light border-0 py-2" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">วันที่สิ้นสุด</label>
                        <input type="date" name="endDate" value="@DateTime.Today.AddDays(15).ToString("yyyy-MM-dd")" class="form-control bg-light border-0 py-2" required />
                    </div>
                </div>
                <button type="submit" class="btn btn-brand w-100 rounded-3 py-2">
                    <i class="bi bi-credit-card me-1"></i>ดำเนินการชำระเงิน (499 ฿)
                </button>
            </form>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <h6 class="fw-bold mb-3"><i class="bi bi-bar-chart-line text-primary me-2"></i>รายการโฆษณาของฉัน</h6>
            @if (!myAds.Any())
            {
                <div class="text-center text-secondary py-5 small">ยังไม่มีรายการโฆษณา</div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var ad in myAds)
                    {
                        <div class="border rounded-3 p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold small">@ad.Title</div>
                                <div class="small text-secondary">@ad.StartDate - @ad.EndDate</div>
                                <div class="small text-secondary mt-1">
                                    <i class="bi bi-eye me-1"></i>@(ad.ViewsCount ?? 0) • <i class="bi bi-cursor me-1"></i>@(ad.ClicksCount ?? 0)
                                </div>
                            </div>
                            <span class="badge rounded-pill @(ad.Status == "active" ? "bg-success" : "bg-warning text-dark")">
                                @(ad.Status == "active" ? "กำลังแสดงผล" : "รออนุมัติ")
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
