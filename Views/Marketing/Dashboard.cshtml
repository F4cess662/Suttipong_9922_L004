@model IEnumerable<Suttipong_9922_L004.Models.Advertisement>
@{
    ViewData["Title"] = "ภาพรวมการตลาด";
    Layout = "_AdminLayout";
}

<div class="row g-4 mb-4">
    <div class="col-12 col-md-4">
        <div class="admin-panel h-100 mb-0">
            <div class="text-secondary small fw-semibold mb-2">โฆษณาที่กำลังแสดงผล</div>
            <div class="d-flex justify-content-between align-items-end">
                <div class="fs-2 fw-bold text-primary">@ViewBag.ActiveAdsCount</div>
                <span class="badge bg-primary-subtle text-primary p-2 rounded-3"><i class="bi bi-megaphone fs-4"></i></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="admin-panel h-100 mb-0">
            <div class="text-secondary small fw-semibold mb-2">จำนวนการมองเห็นรวม</div>
            <div class="d-flex justify-content-between align-items-end">
                <div class="fs-2 fw-bold text-success">@(((int)ViewBag.TotalViews).ToString("N0"))</div>
                <span class="badge bg-success-subtle text-success p-2 rounded-3"><i class="bi bi-eye fs-4"></i></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="admin-panel h-100 mb-0">
            <div class="text-secondary small fw-semibold mb-2">จำนวนการคลิกรวม</div>
            <div class="d-flex justify-content-between align-items-end">
                <div class="fs-2 fw-bold text-warning">@(((int)ViewBag.TotalClicks).ToString("N0"))</div>
                <span class="badge bg-warning-subtle text-dark p-2 rounded-3"><i class="bi bi-cursor fs-4"></i></span>
            </div>
        </div>
    </div>
</div>

<div class="admin-panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-danger me-2"></i>ประสิทธิภาพแคมเปญโฆษณา</h6>
        <div class="d-flex gap-2">
            <a asp-action="Ads" class="btn btn-sm btn-tanglat rounded-3">ป้ายโฆษณา</a>
            <a asp-action="Promotions" class="btn btn-sm btn-light border rounded-3">แพ็กเกจสมาชิก</a>
        </div>
    </div>

    <div class="p-4 rounded-3 bg-light mb-3">
        @foreach (var ad in Model)
        {
            int views = ad.ViewsCount ?? 1;
            int clicks = ad.ClicksCount ?? 0;
            double ctr = views > 0 ? Math.Round((double)clicks / views * 100, 1) : 0;
            <div class="mb-3">
                <div class="d-flex justify-content-between small fw-semibold mb-1">
                    <span>@ad.Title</span>
                    <span><i class="bi bi-eye me-1"></i>@views.ToString("N0") • <i class="bi bi-cursor me-1"></i>@clicks (@ctr%)</span>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar @(ad.Status == "active" ? "bg-success" : "bg-secondary")" style="width: @(Math.Min(100, ctr * 5))%"></div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex flex-wrap justify-content-around small text-secondary pt-2">
        <span><i class="bi bi-circle-fill text-success me-1"></i>กำลังแสดงผล</span>
        <span><i class="bi bi-circle-fill text-secondary me-1"></i>พักการแสดงผล</span>
    </div>
</div>
