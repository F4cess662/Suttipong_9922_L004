@model Suttipong_9922_L004.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "สมัครสมาชิก - ทางลัด";
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f4f7f5;
            font-family: "Noto Sans Thai", "Inter", "Segoe UI", sans-serif;
            color: #1e293b;
        }
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear {
            display: none;
        }
        .brand-panel {
            background: linear-gradient(145deg, #0b3d2e 0%, #145e46 100%);
        }
        .btn-tanglat {
            background-color: #0b3d2e;
            border-color: #0b3d2e;
            color: #fff;
            font-weight: 600;
        }
        .btn-tanglat:hover {
            background-color: #145e46;
            border-color: #145e46;
            color: #fff;
        }
        .nav-pills .nav-link.active {
            background-color: #0b3d2e;
        }
    </style>
</head>
<body>
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center py-4">
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="max-width: 920px; width: 100%;">
        <div class="row g-0">

            <div class="col-12 col-lg-6 p-4 p-md-5 bg-white">
                <div class="d-lg-none mb-3 fs-5 fw-bold" style="color:#0b3d2e;">
                    <i class="bi bi-signpost-split-fill me-1"></i> ทางลัด
                </div>

                <ul class="nav nav-pills mb-4 bg-light p-1 rounded-3 d-inline-flex">
                    <li class="nav-item">
                        <a class="nav-link link-secondary px-4" asp-controller="Account" asp-action="Login">เข้าสู่ระบบ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active px-4" asp-controller="Account" asp-action="Register">สมัครสมาชิก</a>
                    </li>
                </ul>

                <h4 class="fw-bold mb-1">สร้างบัญชีใหม่</h4>
                <p class="text-secondary small mb-4">กรอกข้อมูลเพื่อเริ่มต้นวางแผนการเดินทาง</p>

                <form asp-controller="Account" asp-action="Register" method="post">
                    <div class="mb-3">
                        <label for="Email" class="form-label small fw-semibold">อีเมล</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-secondary"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Username" class="form-label small fw-semibold">ชื่อผู้ใช้</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-secondary"><i class="bi bi-person"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="ชื่อผู้ใช้งาน" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="PhoneNumber" class="form-label small fw-semibold">เบอร์โทรศัพท์</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-secondary"><i class="bi bi-telephone"></i></span>
                            <input asp-for="PhoneNumber" type="tel" class="form-control"
                                   placeholder="08X-XXX-XXXX"
                                   maxlength="10"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Password" class="form-label small fw-semibold">รหัสผ่าน</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-secondary"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="รหัสผ่าน" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="ConfirmPassword" class="form-label small fw-semibold">ยืนยันรหัสผ่าน</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-secondary"><i class="bi bi-shield-lock"></i></span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="ยืนยันรหัสผ่านอีกครั้ง" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-tanglat w-100 py-2 rounded-3 mb-2">สมัครสมาชิก</button>

                    @if (!string.IsNullOrEmpty(ViewBag.Status))
                    {
                        <div class="alert alert-danger py-2 small text-center mt-2">@ViewBag.Status</div>
                    }
                </form>
            </div>

            <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center brand-panel p-5">
                <div class="text-center text-white">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white mb-4 shadow-sm"
                         style="width:150px; height:150px; overflow:hidden;">
                        <img src="~/img/tanglat-icon.png" alt="Logo" style="max-width:110px; max-height:110px;"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        <i class="bi bi-signpost-split-fill text-success" style="font-size: 56px; display:none;"></i>
                    </div>
                    <h3 class="fw-bold mb-2">ทางลัด</h3>
                    <p class="text-white-50 small mb-0 px-4">
                        วางแผนการเดินทางและเปรียบเทียบระบบขนส่งสาธารณะในที่เดียว
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>
</body>
</html>
