@{
    ViewData["Title"] = "แดชบอร์ดระบบ";
    Layout = "_AdminLayout";
    string chartJson = ViewBag.CategoryChartJson as string ?? "[0,0,0,0]";
}

<div class="row g-4 mb-4">
    <div class="col-12 col-lg-6">
        <div class="admin-panel h-100 mb-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-hdd-network text-primary me-2"></i>ข้อมูลระบบและพิกัดสถานที่</h6>
                <span class="badge bg-success-subtle text-success"><i class="bi bi-circle-fill me-1" style="font-size:8px;"></i>ออนไลน์</span>
            </div>
            <div class="p-4 rounded-3 bg-light mb-3 text-center">
                <div class="row g-3">
                    <div class="col-6 border-end">
                        <div class="text-secondary small">สถานที่ในระบบ</div>
                        <div class="fs-2 fw-bold text-dark">@ViewBag.LocationCount</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary small">ระบบขนส่งสาธารณะ</div>
                        <div class="fs-2 fw-bold text-primary">@ViewBag.TransportCount</div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-between small text-secondary">
                <span><i class="bi bi-map text-success me-1"></i>Leaflet + OSRM API</span>
                <span><i class="bi bi-database-check text-success me-1"></i>MySQL Database</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="admin-panel h-100 mb-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-exclamation-octagon text-danger me-2"></i>สถานะคำร้องและผู้ใช้งาน</h6>
                <a asp-action="Issues" class="btn btn-sm btn-light border rounded-3">ดูทั้งหมด</a>
            </div>
            <div class="p-4 rounded-3 bg-light mb-3 text-center">
                <div class="row g-3">
                    <div class="col-6 border-end">
                        <div class="text-secondary small">คำร้องรอแก้ไข (Dev)</div>
                        <div class="fs-2 fw-bold text-danger">@ViewBag.OpenBugs</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary small">ผู้ใช้งานทั้งหมด</div>
                        <div class="fs-2 fw-bold text-success">@ViewBag.TotalUsers</div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-between small text-secondary">
                <span><i class="bi bi-clock text-warning me-1"></i>อัปเดตข้อมูลเรียลไทม์</span>
                <span><i class="bi bi-shield-check text-primary me-1"></i>ระบบทำงานปกติ</span>
            </div>
        </div>
    </div>
</div>

<div class="admin-panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart-fill text-success me-2"></i>สถิติจำนวนสถานที่ท่องเที่ยวในฐานข้อมูล (แยกตามหมวดหมู่)</h6>
        <div class="d-flex gap-2">
            <a asp-action="Places" class="btn btn-sm btn-tanglat rounded-3"><i class="bi bi-geo-alt me-1"></i>จัดการสถานที่</a>
            <a asp-action="Pricing" class="btn btn-sm btn-light border rounded-3"><i class="bi bi-sliders me-1"></i>อัตราค่าโดยสาร</a>
        </div>
    </div>

    <div style="height: 280px;">
        <canvas id="devCategoryChart"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('devCategoryChart');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['สถานที่ท่องเที่ยว', 'ร้านอาหาร', 'แหล่งช้อปปิ้ง', 'จุดเชื่อมต่อ / อื่นๆ'],
                datasets: [{
                    label: 'จำนวนสถานที่ (แห่ง)',
                    data: @Html.Raw(chartJson),
                    backgroundColor: ['#0b3d2e', '#198754', '#0d6efd', '#6c757d'],
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    </script>
}
