@model Suttipong_9922_L004.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    /* hide the browser's own native password-reveal icon (Edge) so there's only one icon */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
        display: none;
    }
</style>

<div class="container-fluid bg-light min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="max-width: 960px; width: 100%;">
        <div class="row g-0">

            <!-- Form column -->
            <div class="col-12 col-lg-6 p-4 p-md-5 bg-white">

                <!-- Mobile-only wordmark (brand panel hidden below lg) -->
                <div class="d-lg-none mb-4 fs-4 fw-bold text-primary">
                    <i class="bi bi-signpost-split-fill"></i> ทางลัด
                </div>

                <ul class="nav nav-pills mb-4">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Account" asp-action="Login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link link-secondary" asp-controller="Account" asp-action="Register">Register</a>
                    </li>
                </ul>

                <h4 class="fw-bold mb-1">ยินดีต้อนรับกลับ</h4>
                <p class="text-secondary mb-4">เข้าสู่ระบบเพื่อวางแผนเส้นทางของคุณ</p>

                <form asp-controller="Account" asp-action="Login" method="post">

                    <input type="hidden" name="Email" value="@ViewBag.Email" />
                    <input type="hidden" name="PhoneNumber" value="@ViewBag.PhoneNumber" />
                    <input type="hidden" name="Source" value="@ViewBag.Source" />

                    <div class="mb-3">
                        <label for="Username" class="form-label">อีเมลหรือชื่อผู้ใช้</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="กรอกชื่อผู้ใช้งาน">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Password" class="form-label">รหัสผ่าน</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="กรอกรหัสผ่าน">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox">
                            <label class="form-check-label text-secondary" for="RememberMe">จดจำฉัน</label>
                        </div>
                        <a href="#" class="link-primary text-decoration-none small">ลืมรหัสผ่าน?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">เข้าสู่ระบบ</button>
                    <p class="text-danger text-center">@ViewBag.Status</p>
                    <p class="text-center text-secondary small mb-0">
                        ยังไม่มีบัญชี?
                        <a asp-controller="Account" asp-action="Register" class="link-primary text-decoration-none">สมัครสมาชิก</a>
                    </p>

                </form>
            </div>

            <!-- Logo / brand column: placeholder area reserved for the real logo image -->
            <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center bg-primary p-5">
                <div class="text-center text-white">

                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white bg-opacity-25 mb-3"
                         style="width:180px; height:180px;">
                        <span class="fs-5 fw-semibold">Logo</span>
                    </div>

                    <div class="fs-4 fw-bold">ทางลัด</div>
                </div>
            </div>

        </div>
    </div>
</div>
